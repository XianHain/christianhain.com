{% layout "../base.liquid" %}

{% block content %}
  <main class="page__content printable">
    {% capture cv_meta %}
      <p class="page-title__meta">
        <span>Version: <time datetime="{{ lastmod | date: "%Y-%m-%dT%H:%M:%S%z" }}">{{ lastmod | date: "%Y-%m-%d" }}</time></span>
      </p>
      <p class="page-title__meta">Atlanta, GA, USA</p>
    {% endcapture %}

    {% include "../../components/page-title/page-title.liquid",
      contentH1: "<i>Curriculum Vitae</i>",
      contentMeta: cv_meta
    %}

    {{ content | formatted }}
  </main>
{% endblock %}
