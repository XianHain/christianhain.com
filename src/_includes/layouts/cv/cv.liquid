{% layout "../base.liquid" %}

{% block content %}
  <main class="page__content printable">
    {% capture cv_h1 %}
      <i lang="la">Curriculum Vitae</i>
    {% endcapture %}

    {% capture cv_meta %}
      <div class="cv-meta">
        <p>
          <span>Version: <time datetime="{{ lastmod | date: "%Y-%m-%dT%H:%M:%S%z" }}">{{ lastmod | date: "%Y-%m-%d" }}</time></span>
        </p>
        <p>Atlanta, GA, USA</p>
      </div>
    {% endcapture %}

    {% include "../../components/page-title/page-title.liquid",
      contentH1: cv_h1,
      contentMeta: cv_meta
    %}

    {{ content | formatted }}
  </main>
{% endblock %}
