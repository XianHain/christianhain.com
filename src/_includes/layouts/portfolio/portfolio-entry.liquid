{% layout "../base.liquid" %}

{% block content %}
  <main class="page__content" data-theme="portfolio">
    <article>
      {% include "../../components/page-title/page-title.liquid",
        contentH1: headTitle
      %}

      <div class="portfolio">
        <aside class="portfolio__sidebar">
          <p>{{ headDescription | formatted }}</p>
          <dl>
            {% for metadatum in metadata %}
              <dt>{{ metadatum.title }}</dt>
              {% for metadatumValue in metadatum.values %}
                <dd>
                  {% if metadatumValue.type == "string" %}
                    {{ metadatumValue.displayValue }}
                  {% elsif metadatumValue.type == "date" %}
                    <time datetime="{{ metadatumValue.datetime }}">
                      {{ metadatumValue.displayValue }}
                    </time>
                  {% elsif metadatumValue.type == "href" %}
                    <a
                      rel="nofollow"
                      href="{{ metadatumValue.href }}"
                      title="{{ metadatumValue.title }}"
                      target="_blank"
                    >
                      {{ metadatumValue.displayValue }}
                    </a>
                  {% endif %}
                </dd>
              {% endfor %}
            {% endfor %}
          </dl>
        </aside>
        <section class="portfolio__content">
          {{ content | formatted }}
        </section>
      </div>
    </article>
  </main>
{% endblock %}
