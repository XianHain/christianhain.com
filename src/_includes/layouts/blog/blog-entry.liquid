{% layout "../base.liquid" %}

{% block content %}
  {% assign songquote_content = content | songquote %}
  {% assign postscript_content = content | postscript %}

  <main class="page__content printable">
    <article class="blog">
      {% capture blog_meta %}
        {% include "../../components/blog-date-and-read-time/blog-date-and-read-time.liquid",
          contentBlogPublishDate: date,
          contentBlogReadTimeInMinutes: readTime
        %}
      {% endcapture %}

      {% include "../../components/page-title/page-title.liquid",
        contentH1: title,
        contentMeta: blog_meta
      %}
      <div class="blog__copy">
        {% if songquote_content != "" %}
          <div class="blog__songquote" data-theme="memo-aux">
            {{ songquote_content | formatted | safe }}
            <br>
          </div>
        {% endif %}
        <div data-theme="memo">
          {{ content | formatted | safe }}
        </div>
      </div>
      <p class="blog__signature">&mdash; {{ author }}</p>

      {% if postscript_content != "" or musicUrl %}
        <aside class="blog__copy blog__postscript" data-theme="memo-aux">
          {{ postscript_content | safe }}
          {% if musicUrl %}
            <div class="blog__music">
              <iframe
                src="{{ musicUrl }}"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen="true"
              ></iframe>
            </div>
          {% endif %}
        </aside>
      {% endif %}
    </article>
  </main>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "url": "{{ url }}",
      "text": "{{ brief }}",
      "headline": "{{ title }}",
      "datePublished": "{{ date }}",
      "copyrightHolder": "CRHain Design LLC",
      "author": {
        "@type": "Person",
        "givenName": "{{ authorGiven }}",
        "familyName": "{{ authorFamily }}"
      }
    }
  </script>
{% endblock %}
