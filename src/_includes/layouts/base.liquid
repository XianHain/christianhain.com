<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <meta name="author" content="{{ site.authorName }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="keywords" content="{{ site.keywords }}">
  <meta name="generator" content="Eleventy">
  <meta name="application-name" content="{{ site.title | escape }}">

  {% if headDescription %}
    <meta name="description" content="{{ headDescription | escape }}">
  {% else %}
    <meta name="description" content="{{ site.description }}">
  {% endif %}

  {% if themeColor %}
    <meta name="theme-color" content="{{ themeColor }}">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@XianHain">
  <meta name="twitter:image" content="{{ ogImage | default: site.favicon.url }}">
  <meta name="twitter:title" content="{{ headTitle | escape | default: site.title }}">
  <meta name="twitter:description" content="{{ headDescription | escape | default: site.description }}">

  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage | default: site.favicon.url }}">
  <meta property="og:title" content="{{ headTitle | escape | default: site.title }}">
  <meta property="og:description" content="{{ headDescription | escape | default: site.description }}">

  {% if blogpost %}
    <meta property="og:type" content="article">
    <meta property="article:published_time" content="{{ blogpost.publishedAt }}">
  {% else %}
    <meta property="og:type" content="website">
  {% endif %}

  <title>
    {% if headTitle %}
      {{ headTitle }} &mdash;
    {% endif %}
    @XianHain
  </title>

  <link rel="canonical" href="{{ canonical }}">
  <link rel="icon" type="{{ site.favicon.type }}" href="{{ site.favicon.url }}">
  <link rel="apple-touch-icon" href="{{ site.favicon.url }}">

  <link rel="preconnect"         href="https://fonts.googleapis.com">
  <link rel="preconnect"         href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap">
  <link rel="stylesheet"         href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" media="print" onload="this.media='all'">
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Edu+TAS+Beginner&family=Sometype+Mono:ital,wght@0,400..700;1,400..700&display=swap">
  <link rel="stylesheet"         href="https://fonts.googleapis.com/css2?family=Edu+TAS+Beginner&family=Sometype+Mono:ital,wght@0,400..700;1,400..700&display=swap" media="print" onload="this.media='all'">

  <link rel="preload" as="style" href="https://assets.christianhain.com/fonts/webfontkit-20250111-030900/stylesheet.css">
  <link rel="stylesheet"         href="https://assets.christianhain.com/fonts/webfontkit-20250111-030900/stylesheet.css" media="print" onload="this.media='all'">
  <link rel="preload" as="style" href="https://assets.christianhain.com/fonts/monolisa-webfont/monolisa.css">
  <link rel="stylesheet"         href="https://assets.christianhain.com/fonts/monolisa-webfont/monolisa.css" media="print" onload="this.media='all'">
  <link rel="preload" as="style" href="https://assets.christianhain.com/fonts/thyga/thyga-semirounded.css">
  <link rel="stylesheet"         href="https://assets.christianhain.com/fonts/thyga/thyga-semirounded.css" media="print" onload="this.media='all'">
  <link rel="preload" as="style" href="https://assets.christianhain.com/fonts/thyga/thyga-italic.css">
  <link rel="stylesheet"         href="https://assets.christianhain.com/fonts/thyga/thyga-italic.css" media="print" onload="this.media='all'">
  <link rel="preload" as="style" href="https://assets.christianhain.com/fonts/thyga/thyga-italic-semirounded.css">
  <link rel="stylesheet"         href="https://assets.christianhain.com/fonts/thyga/thyga-italic-semirounded.css" media="print" onload="this.media='all'">

  {% if pageName == "homepage" or pageName == "portfolio" %}
    <style>
      {% capture css %}
        {% include "../../_scss/styles.scss" %}
      {% endcapture %}
      {{ css | cssmin }}
    </style>
  {% else %}
    <link rel="stylesheet" href="/styles.css?v={{ calVer.cssVersion }}">
  {% endif %}
</head>
<body class="page" data-theme="{{ theme }}" data-pagename="{{ pageName }}">

  {% include "../components/header/header.liquid" %}

  {% block content %}
  {% endblock %}

  {% include "../components/footer/footer.liquid" %}

  <script>
