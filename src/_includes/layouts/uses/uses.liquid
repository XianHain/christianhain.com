{% layout "../base.liquid" %}

{% block content %}
  <main class="page__content">
    {% include "../../components/page-title/page-title.liquid",
      contentH1: "/uses",
      contentDescription: "Inspired by <a rel='nofollow' href='https://wesbos.com/' title='Wes Bos&apos; Website' target='_blank'>Wes Bos.</a>"
    %}
    <p>
      This is a
      <a
        href="https://uses.tech/"
        target="_blank"
      >
        <code>/uses</code> Page,
      </a>
      a non-exhaustive list of the tools and programs I use to capture, create, and develop.
    </p>

    <p class="now-content__timestamp">
      Last updated:
      <time datetime="{{ lastmod }}">
        {{ lastmod | fullDateString }}
      </time>
    </p>

    {% assign item_count = 0 %}
    {% for category in uses.categories %}
      <div class="uses-grid">
        <h2 class="uses-grid__heading">{{ category.category }}</h2>
        {% for subcategory in category.items %}
          <div class="uses-grid__subgrid">
            <h3 class="uses-grid__subgrid-heading">{{ subcategory.category }}</h3>
            <div class="uses-grid__subgrid-items">
              {% for item in subcategory.items %}
                {% assign item_count = item_count | plus: 1 %}
                <div
                  data-js="uses-item"
                  role="button"
                  class="uses-item uses-item--{{ category.category | downcase }}"
                  onclick="window.xian.uses.togglePopover(event)"
                  data-href="{{ item.url }}"
                  data-vendor="{{ item.vendor }}"
                  data-license="{{ item.license }}"
                  data-productname="{{ item.productName }}"
                  {% if item.invertInDarkMode %}data-invert-in-dark-mode="true"{% endif %}
                >
                  <div class="uses-item__image-wrapper">
                    <img
                      alt="{{ item.productName }} product image or icon"
                      src="https://assets.christianhain.com/images/pages/uses/{{ item.image }}"
                      class="uses-item__image"
                      width="216"
                      height="216"
                      {% if item_count <= 2 %}
                        fetchpriority="high"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                  </div>
                  <p class="uses-item__name">{{ item.productName }}</p>
                  <button
                    class="uses-item__show-details"
                    title="Show Details"
                    onclick="window.xian.uses.togglePopover(event)"
                  >
                    {% include "../../icons/eye.svg" %}
                  </button>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </main>

  <aside
    data-js="uses-popover"
    class="uses-popover"
    popover="auto"
  >
    <div
      data-js="uses-popover-content"
      class="uses-popover__content"
    ></div>
    <template data-js="uses-product-details">
      <h4
        data-js="product-name populate"
        class="uses-popover__title"
      ></h4>
      <button
        data-js="close-button"
        title="Close"
        class="uses-popover__close"
        onclick="window.xian.uses.togglePopover(event)"
      >
        {% include "../../icons/close.svg" %}
      </button>
      <dl class="uses-popover__details">
        <dt data-js="description">Product Description</dt>
        <dd data-js="description populate"></dd>
        <dt data-js="vendor">Vendor</dt>
        <dd data-js="vendor populate"></dd>
        <dt data-js="license">License</dt>
        <dd data-js="license populate"></dd>
        <dt data-js="url">URL</dt>
        <dd data-js="url">
          <a rel="nofollow" data-js="url populate" target="_blank"></a>
        </dd>
      </dl>
    </template>
  </aside>
{% endblock %}
