{% layout "./base.liquid" %}

{% block content %}
  <main class="page__content">
    <article>
      <div class="page-title">
        <h1 class="page-title__h1">Portfolio</h1>
      </div>
      <ul class="portfolio-list">
        {%- assign sortedPortfolio = collections.portfolio | sort: "data.publishDate" | reverse -%}
        {%- for portfolio in sortedPortfolio -%}
          <li class="portfolio-list__item">
            <a href="{{ portfolio.url }}" class="portfolio-list__link" title="{{ portfolio.data.headTitle }}">
              <img
                alt="{{ portfolio.data.headTitle }} project image"
                src="{{ portfolio.data.thumbnail }}"
                class="portfolio-list__image"
                width="636"
                height="400"
                {% if forloop.index <= 3 %}
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              />
              <div class="portfolio-list__content">
                <h2 class="portfolio-list__title">{{ portfolio.data.headTitle }}</h2>
                <p><time datetime="{{ portfolio.data.publishDate | date: '%Y-%m-%d' }}">{{ portfolio.data.publishDate | date: '%B %d, %Y' }}</time></p>
                <p class="portfolio-list__synopsis">{{ portfolio.data.headDescription }}</p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </article>

    <nav class="blog-nav">
      <ul class="blog-nav__link-list">
        {% if pagination.previousPageLink %}
          <li>
            <a class="blog-nav__link" href="{{ pagination.previousPageLink }}">
              Previous
            </a>
          </li>
        {% endif %}
        {% if pagination.nextPageLink %}
          <li>
            <a class="blog-nav__link" href="{{ pagination.nextPageLink }}">
              Next
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>

    <aside>
      <a
        rel="nofollow"
        href="https://behance.net/CRHain"
        class="portfolio-list__promo"
        title="View more work on Behance"
        target="_blank"
      >
        <div>
          <img
            alt="Behance"
            src="https://assets.christianhain.com/images/behance-promo-2026.webp"
            class="portfolio-list__promo-image"
            width="636"
            height="400"
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="portfolio-list__promo-title">More on Behance</h2>
          <p class="portfolio-list__promo-synopsis">
            Check out some throwback designs posted on Behance.
          </p>
        </div>
      </a>
    </aside>
  </main>
{% endblock %}
